# Contact form email delivery (server-side only)
RESEND_API_KEY="re_replace_with_your_api_key"
RESEND_FROM_EMAIL="Kremisi <contatti@kremisi.com>"
CONTACT_EMAIL_TO="info@kremisi.com"

# OpenAI Ads CAPI (server-side only; provision the secret in the deployment settings)
