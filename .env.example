# Contact form email delivery (server-side only)
RESEND_API_KEY="re_replace_with_your_api_key"
RESEND_FROM_EMAIL="Kremisi <contatti@kremisi.com>"
CONTACT_EMAIL_TO="info@kremisi.com"

# Contact form anti-spam (public widget identifier + server-only verification secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# Existing iubenda plan supports en-GB only. Add it/en here after enabling them
# in the iubenda dashboard (comma-separated). The site button is localized independently.
NEXT_PUBLIC_IUBENDA_LANGUAGES=en-GB

# OpenAI Ads CAPI (server-side only; provision the secret in the deployment settings)
OPENAI_ADS_CONVERSIONS_API_KEY=""
# Set true only for local CAPI validation, which does not save conversions.
OPENAI_ADS_VALIDATE_ONLY=false
